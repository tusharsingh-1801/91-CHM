DATABASE_URL=postgresql://your-user@127.0.0.1:5432/terrascope
API_PORT=3001
WEB_PORT=5173
PYTHON_ENGINE_URL=http://127.0.0.1:8000
EARTH_ENGINE_PROJECT_ID=your-earth-engine-enabled-project-id
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
VITE_GOOGLE_MAPS_MAP_ID=your-google-map-id
AUTH_MODE=required
APP_ORIGIN=http://localhost:5173
AUTH_SECURE_COOKIE=0
PHOTO_STORAGE_DIR=.local/scouting-photos
JOB_CONCURRENCY=2

# Optional project-managed native PostgreSQL (initialized cluster required)
# LOCAL_PG_BIN=/path/to/postgres/bin
# LOCAL_PG_DATA=.local/postgres-data

# Optional: allow phones/tablets on the same trusted Wi-Fi to open the frontend
# WEB_HOST=0.0.0.0

# Evidence acceptance/freshness heuristics; validate locally for your crops and parcel sizes.
EVIDENCE_MIN_COVERAGE=70
EVIDENCE_MIN_PIXELS=10
EVIDENCE_FRESH_DAYS=14
EVIDENCE_DECLINE_THRESHOLD=0.10
SATELLITE_SEARCH_DAYS=90
SATELLITE_CANDIDATE_LIMIT=100
SATELLITE_MAX_ATTEMPTS=6



# Google AI Studio Gemini key (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional server-only Google Weather API key. Open-Meteo is used when unset.
GOOGLE_WEATHER_API_KEY=

{
  "name": "tushar-p3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names web,api,engine \"npm run dev:client\" \"npm run dev:server\" \"npm run dev:engine\"",
    "dev:client": "vite --config frontend/vite.config.ts",
    "demo": "vite --config frontend/vite.config.ts --mode showcase",
    "sarvam:check": "node scripts/check-sarvam.mjs",
    "dev:server": "tsx backend/api/server.ts",
    "typecheck": "tsc -b",
    "test": "npm run test:launcher && node --import tsx --test backend/api/**/*.test.ts",
    "test:integration": "CHM_INTEGRATION=1 node --import tsx --test backend/api/services/*.integration.test.ts",
    "test:launcher": "node --test scripts/local.test.mjs",
    "test:research": "node --import tsx --test shared/research/*.test.ts",
    "build": "npm run typecheck && vite --config frontend/vite.config.ts build",
    "lint": "oxlint frontend backend",
    "preview": "vite --config frontend/vite.config.ts preview",
    "premigrate": "node scripts/local.mjs database",
    "migrate": "node-pg-migrate up -j ts -m backend/database/migrations --envPath .env",
    "db:start": "node scripts/local.mjs database",
    "start": "node scripts/local.mjs start",
    "stop": "node scripts/local.mjs stop",
    "status": "node scripts/local.mjs status",
    "dev:engine": "node scripts/local.mjs engine",
    "test:smoke": "node scripts/smoke.mjs",
    "test:ui": "playwright test",
    "submission:check": "node scripts/submission-preflight.mjs",
    "sync:data": "node scripts/sync-data.mjs",
    "data:import-demo": "node scripts/import-public-demo.mjs",
    "data:download": "node scripts/download-public-boundaries.mjs",
    "photos:audit": "tsx scripts/cleanup-orphan-photos.ts",
    "photos:cleanup": "tsx scripts/cleanup-orphan-photos.ts --apply",
    "photos:test": "node --import tsx --test scripts/cleanup-orphan-photos.test.ts",
    "data:sync:references": "node --import tsx scripts/sync-reference-datasets.ts"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "geotiff": "^3.0.5",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/google.maps": "^3.66.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
